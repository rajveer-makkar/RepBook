# Supabase — create a project at https://supabase.com, copy the URL + anon key from
# Project Settings → API. URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — powers the "AI explain" button on generated programs.
ANTHROPIC_API_KEY=
# or
OPENAI_API_KEY=